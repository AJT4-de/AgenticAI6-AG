"""
tools/pdf_tool.py
──────────────────────────────────────────────────────────────────────
CrewAI-compatible tool that assembles text + image into a styled PDF
using fpdf2.  Sanitises Unicode characters that the built-in
Helvetica font cannot render (em-dash, bullets, smart quotes, etc.).

Uses BaseTool (not @tool decorator) so we can accept flexible input
-- Llama 3 sometimes passes arguments as dicts instead of strings.
──────────────────────────────────────────────────────────────────────
"""

from __future__ import annotations

import datetime
import re
from pathlib import Path
from typing import Any, Type

from crewai.tools import BaseTool
from fpdf import FPDF
from pydantic import BaseModel, Field

from config.settings import OUTPUT_DIR


# ── Unicode → ASCII mapping for Helvetica compatibility ──────────────
_UNICODE_MAP = {
    "\u2014": "--",     # em-dash  —
    "\u2013": "-",      # en-dash  –
    "\u2018": "'",      # left single quote '
    "\u2019": "'",      # right single quote '
    "\u201c": '"',      # left double quote "
    "\u201d": '"',      # right double quote "
    "\u2022": "-",      # bullet •
    "\u2026": "...",    # ellipsis …
    "\u00a0": " ",      # non-breaking space
    "\u200b": "",       # zero-width space
    "\u2212": "-",      # minus sign −
    "\u00b7": "-",      # middle dot ·
    "\u25cf": "-",      # black circle ●
    "\u25cb": "-",      # white circle ○
    "\u2713": "[x]",    # check mark ✓
    "\u2714": "[x]",    # heavy check mark ✔
    "\u2715": "[!]",    # multiplication X ✕
    "\u2716": "[!]",    # heavy multiplication X ✖
    "\u00ab": "<<",     # «
    "\u00bb": ">>",     # »
}


def _sanitize(text: str) -> str:
    """Replace Unicode characters that Helvetica cannot render.
    NOTE: Markdown markers (**bold**, *italic*, __underline__) are
    preserved here — they are handled during PDF rendering.
    """
    for char, replacement in _UNICODE_MAP.items():
        text = text.replace(char, replacement)
    # Strip remaining non-Latin-1 characters to avoid crashes
    text = text.encode("latin-1", errors="replace").decode("latin-1")
    return text


def _coerce_str(value: Any) -> str:
    """Coerce a value to str, handling the dict format Llama 3 sends."""
    if isinstance(value, dict):
        return str(value.get("description", "") or value)
    return str(value).strip()


def _coerce_float(value: Any) -> float:
    """Coerce a value to float, handling the dict format Llama 3 sends."""
    if isinstance(value, dict):
        raw = value.get("description", 0)
    else:
        raw = value
    try:
        return float(raw)
    except (TypeError, ValueError):
        return 0.0


def _fix_image_path(raw: str) -> str:
    """Recover a valid image path from a possibly-mangled string.

    Llama 3 often strips backslashes, turning
      D:\\ResearchProject\\AgenticAI6\\output\\illustration_xxx.png
    into
      D:ResearchProjectAgenticAI6outputillustration_xxx.png

    Strategy:
      1. If the path already exists on disk, return it as-is.
      2. Try to find the illustration filename and look it up in OUTPUT_DIR.
      3. Fall back to the most recent illustration_*.png in OUTPUT_DIR.
    """
    if not raw:
        return ""
    p = Path(raw)
    if p.exists():
        return raw

    # Extract just the filename (everything after the last known folder name)
    # Patterns like "...outputillustration_YYYYMMDD_HHMMSS.png"
    m = re.search(r'(illustration_\d{8}_\d{6}\.png)$', raw)
    if m:
        candidate = OUTPUT_DIR / m.group(1)
        if candidate.exists():
            return str(candidate)

    # Fall back to the most recent illustration in output dir
    illustrations = sorted(OUTPUT_DIR.glob("illustration_*.png"))
    if illustrations:
        return str(illustrations[-1])

    return raw  # give up, return original


# ── Rich-text renderer ───────────────────────────────────────────────
_INLINE_RE = re.compile(
    r'(__(.+?)__)'           # __underline__
    r'|(\*\*(.+?)\*\*)'   # **bold**
    r'|(\*(.+?)\*)'        # *italic*
)


def _render_rich_body(pdf: "_ReportPDF", body_text: str) -> None:
    """Render body text with Markdown-style formatting.

    Supported:
      ## Heading   -> 15pt bold underline
      #  Heading   -> 13pt bold
      **bold**     -> inline bold
      *italic*     -> inline italic
      __underline__-> inline underline
      Lines starting with * or - -> bullet list
      Everything else -> 11pt normal
    """
    for paragraph in body_text.split("\n"):
        stripped = paragraph.strip()
        if not stripped:
            pdf.ln(4)
            continue

        # ── Major heading (##) ────────────────────────────────────
        if stripped.startswith("##"):
            heading_text = stripped.lstrip("#").strip()
            pdf.ln(3)
            pdf.set_font("Helvetica", "BU", 15)
            pdf.multi_cell(0, 8, heading_text, new_x="LMARGIN", new_y="NEXT")
            pdf.ln(2)
            continue

        # ── Sub-heading (#) ───────────────────────────────────────
        if stripped.startswith("#"):
            heading_text = stripped.lstrip("#").strip()
            pdf.ln(2)
            pdf.set_font("Helvetica", "B", 13)
            pdf.multi_cell(0, 7, heading_text, new_x="LMARGIN", new_y="NEXT")
            pdf.ln(1)
            continue

        # ── Bullet list item (* or -) ────────────────────────────
        if stripped.startswith(("* ", "- ")):
            item_text = stripped[2:].strip()
            pdf.set_font("Helvetica", size=11)
            pdf.cell(6, 6, chr(127), new_x="END", new_y="TOP")  # bullet char
            _write_inline_formatted(pdf, item_text, base_size=11)
            pdf.ln(6)
            continue

        # ── Normal paragraph ─────────────────────────────────────
        _write_inline_formatted(pdf, stripped, base_size=11)
        pdf.ln(6)


def _write_inline_formatted(pdf: "_ReportPDF", text: str, base_size: int = 11) -> None:
    """Write a line handling **bold**, *italic*, and __underline__ spans."""
    last_end = 0
    for m in _INLINE_RE.finditer(text):
        # text before this match
        before = text[last_end:m.start()]
        if before:
            pdf.set_font("Helvetica", "", base_size)
            pdf.write(6, before)

        if m.group(2):      # __underline__
            pdf.set_font("Helvetica", "U", base_size)
            pdf.write(6, m.group(2))
        elif m.group(4):    # **bold**
            pdf.set_font("Helvetica", "B", base_size)
            pdf.write(6, m.group(4))
        elif m.group(6):    # *italic*
            pdf.set_font("Helvetica", "I", base_size)
            pdf.write(6, m.group(6))

        last_end = m.end()

    # remaining text after last match
    remainder = text[last_end:]
    if remainder:
        pdf.set_font("Helvetica", "", base_size)
        pdf.write(6, remainder)


class _ReportPDF(FPDF):
    """Thin wrapper around FPDF with a consistent header / footer."""

    def __init__(self, title: str, language: str, target_group: str):
        super().__init__()
        self.report_title = _sanitize(title)
        self.report_language = _sanitize(language)
        self.report_target = _sanitize(target_group)
        self.add_page()

    # ── Header ────────────────────────────────────────────────────────
    def header(self):
        self.set_font("Helvetica", "B", 14)
        self.cell(0, 10, self.report_title, align="C", new_x="LMARGIN", new_y="NEXT")
        self.set_font("Helvetica", "I", 9)
        meta = f"Audience: {self.report_target}  |  Language: {self.report_language}"
        self.cell(0, 6, meta, align="C", new_x="LMARGIN", new_y="NEXT")
        self.ln(4)

    # ── Footer ────────────────────────────────────────────────────────
    def footer(self):
        self.set_y(-15)
        self.set_font("Helvetica", "I", 8)
        self.cell(0, 10, f"Page {self.page_no()}/{{nb}}", align="C")


class GeneratePdfInput(BaseModel):
    """Flexible input schema -- accepts args as str/float or dict."""
    title: Any = Field(..., description="Report title.")
    body_text: Any = Field(..., description="The full educational text to include.")
    image_path: Any = Field(..., description="Absolute path to the illustration image.")
    target_group: Any = Field(..., description="Intended audience label.")
    language: Any = Field(..., description="Language of the report content.")
    accessibility_score: Any = Field(..., description="Flesch-Kincaid readability score.")


class GeneratePdfTool(BaseTool):
    name: str = "generate_pdf"
    description: str = (
        "Assemble text and an image into a professional PDF report. "
        "Pass all arguments as plain strings (not dicts). "
        "Returns the absolute file path of the generated PDF."
    )
    args_schema: Type[BaseModel] = GeneratePdfInput

    def _run(
        self,
        title: Any,
        body_text: Any,
        image_path: Any,
        target_group: Any,
        language: Any,
        accessibility_score: Any,
    ) -> str:
        # Coerce all inputs (handles Llama 3 dict format)
        title = _coerce_str(title)
        body_text = _coerce_str(body_text)
        image_path = _fix_image_path(_coerce_str(image_path))
        target_group = _coerce_str(target_group)
        language = _coerce_str(language)
        accessibility_score = _coerce_float(accessibility_score)

        # ── Guard: reject placeholder / empty body text ──────────
        clean_check = body_text.strip().strip('.')
        if len(clean_check) < 200:
            # Check if a good PDF already exists for this title
            safe_chk = re.sub(r'[<>:"/\\|?*]', '_', title).strip().strip('.')
            safe_chk = safe_chk[:100] or "report"
            matches = sorted(OUTPUT_DIR.glob(f"{safe_chk}_*.pdf"))
            if matches:
                return str(matches[-1])  # return most recent
            return (
                "ERROR: body_text is too short or is a placeholder. "
                "You must pass the FULL educational text, not a reference "
                "like '(full educational text provided above)'. "
                "Copy the entire text into the body_text argument."
            )

        pdf = _ReportPDF(title=title, language=language, target_group=target_group)
        pdf.alias_nb_pages()

        # Sanitise the body text before rendering
        body_text = _sanitize(body_text)

        # ── Infographic / illustration (BEFORE body text) ────────────
        if image_path and Path(image_path).exists():
            usable_w = pdf.w - pdf.l_margin - pdf.r_margin
            pdf.image(image_path, x=pdf.l_margin, w=usable_w)
            pdf.ln(6)

        # ── Body text (with rich formatting) ──────────────────────────
        _render_rich_body(pdf, body_text)

        # ── Accessibility / readability badge ─────────────────────────
        pdf.ln(8)
        pdf.set_font("Helvetica", "I", 10)
        pdf.cell(
            0,
            6,
            f"Accessibility Score (Flesch-Kincaid): {accessibility_score:.1f}",
            new_x="LMARGIN",
            new_y="NEXT",
        )

        # ── Save ──────────────────────────────────────────────────────
        # Use sanitised title + timestamp as filename
        safe_name = re.sub(r'[<>:"/\\|?*]', '_', title).strip().strip('.')
        safe_name = safe_name[:100] or "report"          # cap length
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"{safe_name}_{timestamp}.pdf"
        out_path = OUTPUT_DIR / filename
        pdf.output(str(out_path))
        return str(out_path)


# Module-level instance for easy import
generate_pdf_tool = GeneratePdfTool()
